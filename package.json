{
  "name": "bizpockethub-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend/shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:shared": "npm run build --workspace=backend/shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:api": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=frontend",
    "start": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=backend/shared && npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=backend",
    "clean": "npm run clean --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "country-state-city": "^3.2.1"
  }
}
